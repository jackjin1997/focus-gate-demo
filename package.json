{
  "name": "focus-gate-demo",
  "version": "0.1.0",
  "private": false,
  "description": "专注之门 FocusEvent interactive prototype",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "local": "pnpm build && tsx server/index.ts",
    "runtime:start": "tsx server/index.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "qa:visual": "node scripts/visual-qa.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.8",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "hono": "^4.12.29",
    "lucide-react": "^0.451.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.0.0",
    "tsx": "^4.23.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=24 <26"
  },
  "packageManager": "pnpm@10.29.1"
